# 总控镜像: Go 后端 + React 前端
FROM node:24-alpine3.24@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS webbuild
WORKDIR /web
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.26.7-alpine3.24@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/controller ./cmd/controller \
    && sh ./scripts/build-agent-dist.sh /out

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=gobuild /out/controller /app/controller
COPY --from=gobuild /out/agent-linux-* /app/dist/
COPY --from=webbuild /web/dist /app/web/dist
EXPOSE 8443
ENTRYPOINT ["/app/controller", "--config", "/app/controller.yaml"]
