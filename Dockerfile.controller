# 总控镜像: Go 后端 + React 前端
FROM node:20-alpine AS webbuild
WORKDIR /web
COPY web/package*.json ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.22-alpine AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/controller ./cmd/controller

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=gobuild /out/controller /app/controller
COPY --from=webbuild /web/dist /app/web/dist
EXPOSE 8443
ENTRYPOINT ["/app/controller", "--config", "/app/controller.yaml"]
