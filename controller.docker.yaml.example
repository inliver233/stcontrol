# Docker 直连 TLS 示例。复制为 controller.docker.yaml 后替换域名，并把
# tls.crt/tls.key 放到仓库根目录 certs/（该目录不会被提交）。
public_url: https://account.example.com:8443
listen: :8443
tls_cert_file: /run/stcontrol-tls/tls.crt
tls_key_file: /run/stcontrol-tls/tls.key
# 将下面第二个 stcontrol 替换为与 DB_PASSWORD 相同且已 URL 转义的密码。
database_url: postgres://stcontrol:stcontrol@db:5432/stcontrol?sslmode=disable
secret_key_env: CONTROLLER_SECRET_KEY
static_dir: /app/web/dist

relay:
  listen: ""
  public_url: ""
  data_dir: /app/controller-relay-data
  tls_cert_file: ""
  tls_key_file: ""
  max_bytes: 118111600640
  retention_min: 720
  max_concurrent: 4

node:
  register_cpu: 50
  register_mem: 50
  register_disk: 50
  allocation_hard_pct: 60
  capacity_window_sec: 120
  capacity_sustain_sec: 120
  capacity_recovery_sec: 180
  capacity_cooldown_sec: 300
  min_disk_free_bytes: 5368709120
  max_online_users: 500
  max_task_queue_depth: 50
  heartbeat_timeout_sec: 45

ticket:
  ttl_sec: 60

activity:
  lease_ttl_sec: 900

backup:
  offline_grace_min: 12
  unprotected_alert_min: 60
  retain_versions: 1
  zstd_level: 3
  retry_max: 3
  abort_on_user_login: true

oauth:
  discord:
    enabled: false
    client_id: ""
    client_secret: ""
    callback_url: https://account.example.com:8443/api/auth/oauth/discord/callback
    guild_id: ""
  linuxdo:
    enabled: false
    client_id: ""
    client_secret: ""
    callback_url: https://account.example.com:8443/api/auth/oauth/linuxdo/callback
    auth_url: https://connect.linux.do/oauth2/authorize
    token_url: https://connect.linux.do/oauth2/token
    user_info_url: https://connect.linux.do/api/user

admin:
  username: admin
  password_env: CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD
