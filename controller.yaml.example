# 总控配置
public_url: https://account.example.com
# 反向代理终止 TLS 时只监听 loopback；若直接公网监听，则改为 :8443
# 并配置下面的证书和私钥。
listen: 127.0.0.1:8080
tls_cert_file: ""
tls_key_file: ""
database_url: postgres://stcontrol:stcontrol@127.0.0.1:5432/stcontrol?sslmode=disable
secret_key_env: CONTROLLER_SECRET_KEY
static_dir: ./web/dist
agent_dist_dir: ./dist

# 留空 listen 表示复用总控现有 HTTPS 监听器，不再另开端口。public_url 必须
# 与上面的总控 public_url 一致；存储 Agent 因而只需出站连接，不需要域名或证书。
# 如果需要把大流量数据面拆到独立监听器，再配置 listen 和独立 TLS/反向代理。
relay:
  listen: ""
  public_url: https://account.example.com
  data_dir: ./controller-relay-data
  tls_cert_file: ""
  tls_key_file: ""
  max_bytes: 118111600640
  retention_min: 720
  max_concurrent: 4

node:
  register_cpu: 50
  register_mem: 50
  register_disk: 50
  allocation_hard_pct: 60
  capacity_window_sec: 120
  capacity_sustain_sec: 120
  capacity_recovery_sec: 180
  capacity_cooldown_sec: 300
  min_disk_free_bytes: 5368709120
  max_online_users: 500
  max_task_queue_depth: 50
  heartbeat_timeout_sec: 45

ticket:
  ttl_sec: 60

# Must match the managed adapter's sessionIdleMs policy. Only authenticated
# adapter page/request/in-flight facts can extend this generation-fenced lease.
activity:
  lease_ttl_sec: 900

backup:
  offline_grace_min: 12
  unprotected_alert_min: 60
  retain_versions: 1
  zstd_level: 3
  retry_max: 3
  abort_on_user_login: true

oauth:
  discord:
    enabled: false
    client_id: ""
    client_secret: ""
    callback_url: https://account.example.com/api/auth/oauth/discord/callback
    guild_id: ""
  linuxdo:
    enabled: false
    client_id: ""
    client_secret: ""
    callback_url: https://account.example.com/api/auth/oauth/linuxdo/callback
    auth_url: https://connect.linux.do/oauth2/authorize
    token_url: https://connect.linux.do/oauth2/token
    user_info_url: https://connect.linux.do/api/user

admin:
  username: admin
  password_env: CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD

# AI 监管层默认只在后台生成脱敏建议，不参与登录、备份等关键请求路径。
ai_supervisor:
  enabled: false
  mode: shadow
  provider: openai_compatible
  base_url: https://api.example.com/v1
  model: example-model
  api_key_env: STCONTROL_AI_API_KEY
  timeout_ms: 60000
  inspect_every_sec: 1800
  auto_adopt_min_confidence: 0.8
