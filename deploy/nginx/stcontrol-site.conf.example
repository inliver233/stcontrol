server {
    listen 80;
    listen [::]:80;
    server_name account.example.com;

    # Do not copy an untrusted query string from plaintext HTTP into the
    # redirect URL or access log.
    return 301 https://$host$uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name account.example.com;

    ssl_certificate /etc/stcontrol/tls.crt;
    ssl_certificate_key /etc/stcontrol/tls.key;
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:STControlSSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 32m;
    access_log /var/log/nginx/stcontrol.access.log stcontrol_safe;

    # Agent-only storage nodes use the Controller as an end-to-end encrypted
    # transit point. The Go relay enforces its own exact ciphertext limit;
    # disable proxy buffering so Nginx neither duplicates nor truncates the
    # temporary encrypted stream.
    location ^~ /relay/ {
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name account.example.com;
        proxy_ssl_protocols TLSv1.3;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass https://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name account.example.com;
        proxy_ssl_protocols TLSv1.3;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
